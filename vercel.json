{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/sw\\.js$",
      "dest": "/sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate",
        "service-worker-allowed": "/"
      }
    },
    {
      "src": "^/manifest\\.json$",
      "dest": "/manifest.json",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "^/hotel_erp\\.html$",
      "dest": "/hotel_erp.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "^/(.*)\\.(png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf)$",
      "dest": "/$1.$2",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/(.*)$",
      "dest": "/hotel_erp.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
