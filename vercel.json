{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://setu-cloud.theinkthreadhub.workers.dev/api/:path*"
    },
    {
      "source": "/q/:path*",
      "destination": "https://setu-cloud.theinkthreadhub.workers.dev/q/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "https://setu-cloud.theinkthreadhub.workers.dev/download/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://setu-cloud.theinkthreadhub.workers.dev/admin"
    },
    {
      "source": "/admin.webmanifest",
      "destination": "https://setu-cloud.theinkthreadhub.workers.dev/admin.webmanifest"
    },
    {
      "source": "/qr",
      "destination": "https://setu-cloud.theinkthreadhub.workers.dev/qr"
    },
    {
      "source": "/",
      "destination": "/hotel_erp.html"
    },
    {
      "source": "/hotel",
      "destination": "/hotel_erp.html"
    },
    {
      "source": "/pos",
      "destination": "/hotel_erp.html"
    },
    {
      "source": "/gateway",
      "destination": "/hotel_erp.html"
    }
  ],
  "headers": [
    {
      "source": "/hotel_erp.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}