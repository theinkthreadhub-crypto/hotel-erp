{
  "name": "setu-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "node scripts/copy-assets.mjs && wrangler dev",
    "deploy": "node scripts/copy-assets.mjs && wrangler deploy",
    "set-key": "wrangler secret put SETU_SYNC_KEY",
    "new-key": "node -e \"console.log(require('crypto').randomBytes(24).toString('hex'))\""
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
